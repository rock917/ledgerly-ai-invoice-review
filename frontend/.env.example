VITE_API_URL=http://localhost:8001
# Project URL and public publishable key from Supabase Settings > API Keys.
# Never put a service-role JWT or sb_secret_ key in frontend variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional local ERP demonstration only. Leave false on Vercel.
VITE_ENABLE_ERPNEXT=false
